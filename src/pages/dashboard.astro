---
import Layout from '@/layouts/Layout.astro';
import { VideoTaskService } from '@/lib/services/video_task';
import { CustomerService } from '@/lib/services/customer';
import { buttonVariants } from '@/components/ui/button';

const { DB } = Astro.locals.runtime.env;

const videoTaskService = new VideoTaskService(DB);
const customerService = new CustomerService(DB);

const stats = await videoTaskService.getStats();
const recentTasks = await videoTaskService.getAll();
const customers = await customerService.getAll();

const statCards = [
  {
    name: 'Total Videos',
    value: stats.total,
    icon: 'video',
    href: '/gallery',
  },
  {
    name: 'Completed',
    value: stats.completed,
    icon: 'check',
  },
  {
    name: 'Processing',
    value: stats.processing,
    icon: 'loader',
  },
  {
    name: 'Users',
    value: customers.length,
    icon: 'users',
    href: '/admin/customers',
  },
];
---

<Layout title="Dashboard">
  <Fragment slot="actions">
    <a class={buttonVariants()} href="/generate">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12h14"/>
      </svg>
      Generate Video
    </a>
  </Fragment>

  <div class="space-y-8">
    <!-- Stats Grid -->
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {statCards.map((item) => (
        item.href ? (
          <a href={item.href} class="rounded-xl border bg-card text-card-foreground hover:bg-muted shadow transition-colors block">
            <div class="p-6">
              <div class="flex flex-row items-center justify-between space-y-0 pb-2">
                <div class="tracking-tight text-sm font-medium">{item.name}</div>
                {item.icon === 'video' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                    <polygon points="23 7 16 12 23 17 23 7" />
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
                  </svg>
                )}
                {item.icon === 'users' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                )}
              </div>
              <div class="text-2xl font-bold">{item.value}</div>
            </div>
          </a>
        ) : (
          <div class="rounded-xl border bg-card text-card-foreground shadow">
            <div class="p-6">
              <div class="flex flex-row items-center justify-between space-y-0 pb-2">
                <div class="tracking-tight text-sm font-medium">{item.name}</div>
                {item.icon === 'check' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                )}
                {item.icon === 'loader' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                    <line x1="12" y1="2" x2="12" y2="6"/>
                    <line x1="12" y1="18" x2="12" y2="22"/>
                    <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
                    <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
                    <line x1="2" y1="12" x2="6" y2="12"/>
                    <line x1="18" y1="12" x2="22" y2="12"/>
                    <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/>
                    <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
                  </svg>
                )}
              </div>
              <div class="text-2xl font-bold">{item.value}</div>
            </div>
          </div>
        )
      ))}
    </div>

    <!-- Recent Activity -->
    <section class="space-y-4">
      <h3 class="text-xl font-semibold tracking-tight">Recent Generations</h3>
      {recentTasks.length === 0 ? (
        <div class="rounded-xl border bg-card text-card-foreground shadow p-8 text-center">
          <p class="text-muted-foreground">No video generations yet.</p>
          <a href="/generate" class="text-sm underline mt-2 inline-block hover:text-foreground">
            Create your first video
          </a>
        </div>
      ) : (
        <div class="rounded-xl border bg-card text-card-foreground shadow">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b">
                  <th class="px-4 py-3 text-left font-medium">ID</th>
                  <th class="px-4 py-3 text-left font-medium">Prompt</th>
                  <th class="px-4 py-3 text-left font-medium">Status</th>
                  <th class="px-4 py-3 text-left font-medium">Resolution</th>
                  <th class="px-4 py-3 text-left font-medium">Created</th>
                </tr>
              </thead>
              <tbody>
                {recentTasks.slice(0, 10).map((task) => (
                  <tr class="border-b last:border-0">
                    <td class="px-4 py-3 font-mono text-xs">#{task.id}</td>
                    <td class="px-4 py-3 max-w-xs truncate">{task.prompt}</td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ${
                        task.status === 'completed' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' :
                        task.status === 'processing' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' :
                        task.status === 'failed' ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400' :
                        'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400'
                      }`}>
                        {task.status}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-muted-foreground">{task.resolution} · {task.aspect_ratio}</td>
                    <td class="px-4 py-3 text-muted-foreground">{new Date(task.created_at).toLocaleDateString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </section>
  </div>
</Layout>

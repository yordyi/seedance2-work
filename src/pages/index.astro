---
import { buttonVariants } from '@/components/ui/button';
import '@/styles/globals.css'
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const isDark = getThemePreference() === 'dark';
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

  if (typeof localStorage !== 'undefined') {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Seedance - AI Video Generation Platform</title>
    <meta name="description" content="Generate stunning videos from text prompts using Seedance 2.0 AI model. Transform your ideas into professional videos in seconds." />
  </head>
  <body>
    <div class="flex flex-col items-center justify-center min-h-screen gap-6 py-20 px-8">
      <div class="flex items-center gap-3 mb-2">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
          <polygon points="23 7 16 12 23 17 23 7" />
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
        </svg>
        <span class="text-sm font-medium text-muted-foreground tracking-widest uppercase">Seedance 2.0</span>
      </div>

      <h1 class="text-5xl md:text-6xl font-bold text-center max-w-3xl leading-tight">
        Transform Text into <span class="bg-gradient-to-r from-purple-500 to-pink-500 bg-clip-text text-transparent">Stunning Videos</span>
      </h1>

      <p class="text-xl text-muted-foreground text-center max-w-2xl">
        Powered by the Seedance 2.0 AI model. Enter a text prompt and watch your ideas come to life as professional-quality videos.
      </p>

      <div class="flex flex-wrap justify-center gap-4 mt-4">
        <a class={buttonVariants({ size: 'lg' })} href="/generate">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Start Generating
        </a>
        <a class={buttonVariants({ variant: 'outline', size: 'lg' })} href="/gallery">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
          View Gallery
        </a>
        <a class={buttonVariants({ variant: 'outline', size: 'lg' })} href="/pricing">
          Pricing
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16 max-w-4xl w-full">
        <div class="text-center space-y-2">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-muted">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
              <circle cx="12" cy="13" r="3"/>
            </svg>
          </div>
          <h3 class="font-semibold">Text to Video</h3>
          <p class="text-sm text-muted-foreground">Describe your scene and our AI generates high-quality video content</p>
        </div>
        <div class="text-center space-y-2">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-muted">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="font-semibold">Fast Generation</h3>
          <p class="text-sm text-muted-foreground">Generate videos in seconds with our optimized Seedance 2.0 pipeline</p>
        </div>
        <div class="text-center space-y-2">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-muted">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </div>
          <h3 class="font-semibold">Easy Export</h3>
          <p class="text-sm text-muted-foreground">Download your videos in multiple resolutions and aspect ratios</p>
        </div>
      </div>
    </div>
  </body>
</html>
